+++ /var/folders/h_/06_ktbkn4nsg27pdm9xf9gg40000gn/T/tmp.DkkZFjMi1W/src/main/java/dev/example/orders/KafkaErrorHandling.java	2026-09-27 13:21:04
@@ -0,0 +1,23 @@
+package dev.example.orders;
+
+import org.apache.kafka.common.TopicPartition;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.DeadLetterPublishingRecoverer;
+import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.util.backoff.FixedBackOff;
+import tools.jackson.core.JacksonException;
+
+@Configuration
+public class KafkaErrorHandling {
+
+    @Bean
+    DefaultErrorHandler errorHandler(KafkaTemplate<String, String> template) {
+        var recoverer = new DeadLetterPublishingRecoverer(template,
+                (record, ex) -> new TopicPartition(record.topic() + ".DLT", record.partition()));
+        var handler = new DefaultErrorHandler(recoverer, new FixedBackOff(200, 3));
+        handler.addNotRetryableExceptions(OrderNotFoundException.class, JacksonException.class);
+        return handler;
+    }
+}
