+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT id, amount, currency, status FROM charges
+		WHERE $1 = '' OR currency = $1 ORDER BY id LIMIT 50`, currency)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []Charge
+	for rows.Next() {
+		var c Charge
+		if err := rows.Scan(&c.ID, &c.Amount, &c.Currency, &c.Status); err != nil {
+			return nil, err
+		}
+		out = append(out, c)
+	}
+	return out, rows.Err()
+}
+
