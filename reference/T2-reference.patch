+    @QueryMapping
+    public Window<Order> customerOrders(@Argument Long customerId, ScrollSubrange subrange) {
+        if (!customers.existsById(customerId)) {
+            throw new CustomerNotFoundException(customerId);
+        }
+        ScrollPosition position = subrange.position().orElse(ScrollPosition.keyset());
+        int count = subrange.count().orElse(10);
+        return orders.findByCustomerId(customerId, position, Limit.of(count), Sort.by("id"));
+    }
+
+    @BatchMapping
+    public Map<Customer, Integer> orderCount(List<Customer> batch) {
+        Map<Long, Integer> counts = orders
+                .countByCustomerIds(batch.stream().map(Customer::getId).toList())
+                .stream()
+                .collect(Collectors.toMap(r -> (Long) r[0], r -> ((Number) r[1]).intValue()));
+        return batch.stream().collect(Collectors.toMap(
+                Function.identity(), c -> counts.getOrDefault(c.getId(), 0)));
+    }
