+// listLimit caps how many charges List returns.
+const listLimit = 50
+
+// List returns up to listLimit charges in id order. An empty currency means
+// no filter.
+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	query := `SELECT id, amount, currency, status FROM charges`
+	args := []any{listLimit}
+	if currency != "" {
+		query += ` WHERE currency = $2`
+		args = append(args, currency)
+	}
+	query += ` ORDER BY id ASC LIMIT $1`
+	rows, err := s.db.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	defer rows.Close()
+	charges := []Charge{} // encodes as [] rather than null when empty
+	for rows.Next() {
+		var p Charge
+		if err := rows.Scan(&p.ID, &p.Amount, &p.Currency, &p.Status); err != nil {
+			return nil, fmt.Errorf("scan charge: %w", err)
+		}
+		charges = append(charges, p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	return charges, nil
+}
+
