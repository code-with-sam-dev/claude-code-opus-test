+// list returns up to 50 charges in id order, optionally filtered by a
+// currency query parameter such as ?currency=usd.
+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	var currency string
+	query := r.URL.Query()
+	if query.Has("currency") {
+		values := query["currency"]
+		if len(values) != 1 || !isCurrencyCode(values[0]) {
+			http.Error(w, "currency must be three letters A to Z",
+				http.StatusBadRequest)
+			return
+		}
+		currency = strings.ToUpper(values[0])
+	}
+	charges, err := h.charges.List(r.Context(), currency)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if charges == nil {
+		charges = []Charge{} // [] rather than null
+	}
+	writeJSON(w, http.StatusOK, charges)
+}
+
+// isCurrencyCode reports whether s is exactly three ASCII letters, in any case.
+func isCurrencyCode(s string) bool {
+	if len(s) != 3 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c < 'a' || c > 'z') && (c < 'A' || c > 'Z') {
+			return false
+		}
+	}
+	return true
+}
