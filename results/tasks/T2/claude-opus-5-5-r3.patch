diff --git a/src/test/java/dev/example/store/CustomerOrdersTests.java b/src/test/java/dev/example/store/CustomerOrdersTests.java
new file mode 100644
index 0000000..e8b3f2d
--- /dev/null
+++ b/src/test/java/dev/example/store/CustomerOrdersTests.java
@@ -0,0 +1,134 @@
+package dev.example.store;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.BDDMockito.given;
+import static org.mockito.BDDMockito.then;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
+
+import java.time.Instant;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.graphql.test.autoconfigure.GraphQlTest;
+import org.springframework.context.annotation.Import;
+import org.springframework.data.domain.KeysetScrollPosition;
+import org.springframework.data.domain.Limit;
+import org.springframework.data.domain.ScrollPosition;
+import org.springframework.data.domain.Sort;
+import org.springframework.data.domain.Window;
+import org.springframework.graphql.execution.ErrorType;
+import org.springframework.graphql.test.tester.GraphQlTester;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.util.ReflectionTestUtils;
+
+@GraphQlTest(StoreController.class)
+@Import(StoreExceptionResolver.class)
+class CustomerOrdersTests {
+
+    @Autowired
+    GraphQlTester graphQlTester;
+
+    @MockitoBean OrderRepository orders;
+    @MockitoBean OrderLineRepository lines;
+    @MockitoBean CustomerRepository customers;
+    @MockitoBean ItemRepository items;
+    @MockitoBean OrderService service;
+
+    private static Order order(long id, long customerId) {
+        Order order = new Order(customerId, 3_000, Instant.parse("2026-09-01T10:00:00Z"));
+        ReflectionTestUtils.setField(order, "id", id);
+        return order;
+    }
+
+    private static Window<Order> window(List<Order> content, boolean hasNext) {
+        return Window.from(content,
+                i -> ScrollPosition.forward(Map.of("id", content.get(i).getId())), hasNext);
+    }
+
+    @Test
+    void orderCountsForManyCustomersComeFromOneQuery() {
+        given(orders.findBy(any(), any(), any())).willReturn(window(List.of(
+                order(1, 1), order(2, 2), order(3, 3), order(4, 1)), false));
+        given(customers.findAllById(any())).willReturn(List.of(
+                new Customer(1L, "Ada", "ada@example.com", "GOLD"),
+                new Customer(2L, "Grace", "grace@example.com", "SILVER"),
+                new Customer(3L, "Linus", "linus@example.com", "BRONZE")));
+        given(orders.countByCustomerIdIn(any())).willReturn(List.of(
+                new CustomerOrderCount(1L, 10), new CustomerOrderCount(2L, 7)));
+
+        graphQlTester.document("{ orders { edges { node { customer { id orderCount } } } } }")
+                .execute()
+                .path("orders.edges[*].node.customer.orderCount")
+                .entityList(Integer.class).containsExactly(10, 7, 0, 10);
+
+        @SuppressWarnings("unchecked")
+        ArgumentCaptor<Collection<Long>> ids = ArgumentCaptor.forClass(Collection.class);
+        then(orders).should(times(1)).countByCustomerIdIn(ids.capture());
+        assertThat(ids.getValue()).containsExactlyInAnyOrder(1L, 2L, 3L);
+    }
+
+    @Test
+    void customerOrdersDefaultsToTenOrderedById() {
+        given(customers.existsById(1L)).willReturn(true);
+        given(orders.findByCustomerId(anyLong(), any(), any(), any()))
+                .willReturn(window(List.of(order(1, 1), order(4, 1)), false));
+
+        graphQlTester.document("{ customerOrders(customerId: 1) { edges { node { id } } "
+                        + "pageInfo { hasNextPage } } }")
+                .execute()
+                .path("customerOrders.edges[*].node.id")
+                .entityList(String.class).containsExactly("1", "4")
+                .path("customerOrders.pageInfo.hasNextPage").entity(Boolean.class).isEqualTo(false);
+
+        then(orders).should().findByCustomerId(
+                eq(1L), eq(ScrollPosition.keyset()), eq(Limit.of(10)), eq(Sort.by("id")));
+    }
+
+    @Test
+    void customerOrdersContinuesFromTheCursor() {
+        given(customers.existsById(1L)).willReturn(true);
+        given(orders.findByCustomerId(anyLong(), any(), any(), any()))
+                .willReturn(window(List.of(order(1, 1), order(4, 1)), true));
+
+        String endCursor = graphQlTester
+                .document("{ customerOrders(customerId: 1, first: 2) { pageInfo { endCursor } } }")
+                .execute()
+                .path("customerOrders.pageInfo.endCursor").entity(String.class).get();
+
+        graphQlTester.document("query($after: String) { customerOrders(customerId: 1, "
+                        + "first: 2, after: $after) { edges { node { id } } } }")
+                .variable("after", endCursor)
+                .execute()
+                .errors().verify();
+
+        ArgumentCaptor<ScrollPosition> positions = ArgumentCaptor.forClass(ScrollPosition.class);
+        then(orders).should(times(2)).findByCustomerId(
+                eq(1L), positions.capture(), eq(Limit.of(2)), eq(Sort.by("id")));
+        ScrollPosition next = positions.getAllValues().get(1);
+        assertThat(next).isInstanceOf(KeysetScrollPosition.class);
+        KeysetScrollPosition keyset = (KeysetScrollPosition) next;
+        assertThat(keyset.scrollsForward()).isTrue();
+        assertThat(keyset.getKeys().get("id")).hasToString("4");
+    }
+
+    @Test
+    void customerOrdersForAnUnknownCustomerIsNotFound() {
+        given(customers.existsById(42L)).willReturn(false);
+
+        graphQlTester.document("{ customerOrders(customerId: 42) { edges { node { id } } } }")
+                .execute()
+                .errors()
+                .expect(error -> error.getErrorType() == ErrorType.NOT_FOUND
+                        && error.getMessage().contains("No customer 42"))
+                .verify();
+
+        then(orders).should(never()).findByCustomerId(anyLong(), any(), any(), any());
+    }
+}
