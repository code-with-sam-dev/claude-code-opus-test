+
+    // Three customers in the response, one query for their order counts.
+    @Test
+    void orderCountsComeFromOneQuery() {
+        given(orders.findBy(any(), any(), any())).willReturn(Window.from(
+                List.of(order(1L), order(2L), order(3L)), ScrollPosition::offset));
+        given(customers.findAllById(anyCollection())).willReturn(List.of(
+                new Customer(1L, "Ada", "ada@example.com", "GOLD"),
+                new Customer(2L, "Grace", "grace@example.com", "SILVER"),
+                new Customer(3L, "Linus", "linus@example.com", "BRONZE")));
+        given(orders.countOrdersByCustomerIdIn(anyCollection())).willReturn(List.of(
+                new CustomerOrderCount(1L, 4L),
+                new CustomerOrderCount(2L, 1L)));
+
+        graphQlTester.document("{ orders { edges { node { customer { name orderCount } } } } }")
+                .execute()
+                .path("orders.edges[0].node.customer.orderCount")
+                .entity(Integer.class).isEqualTo(4)
+                .path("orders.edges[1].node.customer.orderCount")
+                .entity(Integer.class).isEqualTo(1)
+                // Linus has no row in the grouped result, so no orders.
+                .path("orders.edges[2].node.customer.orderCount")
+                .entity(Integer.class).isEqualTo(0);
+
+        ArgumentCaptor<Collection<Long>> customerIds = ArgumentCaptor.captor();
+        verify(orders).countOrdersByCustomerIdIn(customerIds.capture());
+        assertThat(customerIds.getValue()).containsExactlyInAnyOrder(1L, 2L, 3L);
+    }
+
+    @Test
+    void customerOrdersPagesTenAtATimeByDefault() {
+        given(customers.existsById(1L)).willReturn(true);
+        given(orders.findByCustomerId(eq(1L), any(), any(), any()))
+                .willReturn(Window.from(List.of(order(1L)), ScrollPosition::offset));
+
+        graphQlTester.document("{ customerOrders(customerId: 1) { edges { node { amount } } } }")
+                .execute()
+                .path("customerOrders.edges[0].node.amount")
+                .entity(Integer.class).isEqualTo(3000);
+
+        verify(orders).findByCustomerId(
+                1L, ScrollPosition.keyset(), Limit.of(10), Sort.by("id"));
+    }
+
+    @Test
+    void customerOrdersHonoursFirstAndAfter() {
+        given(customers.existsById(1L)).willReturn(true);
+        given(orders.findByCustomerId(eq(1L), any(), any(), any()))
+                .willReturn(Window.from(List.of(order(1L), order(1L)), ScrollPosition::offset));
+
+        String cursor = graphQlTester
+                .document("{ customerOrders(customerId: 1, first: 2) { edges { cursor } } }")
+                .execute()
+                .path("customerOrders.edges[0].cursor").entity(String.class).get();
+
+        graphQlTester
+                .document("query Page($after: String) {"
+                        + " customerOrders(customerId: 1, first: 2, after: $after)"
+                        + " { edges { node { amount } } } }")
+                .variable("after", cursor)
+                .execute()
+                .path("customerOrders.edges").entityList(Object.class).hasSize(2);
+
+        // The second call starts from the cursor, both ask for two.
+        ArgumentCaptor<ScrollPosition> position = ArgumentCaptor.captor();
+        verify(orders, times(2)).findByCustomerId(
+                eq(1L), position.capture(), eq(Limit.of(2)), eq(Sort.by("id")));
+        assertThat(position.getAllValues())
+                .containsExactly(ScrollPosition.keyset(), ScrollPosition.offset(0));
+    }
+
+    @Test
+    void ordersOfAMissingCustomerAreNotFound() {
+        given(customers.existsById(42L)).willReturn(false);
+
+        graphQlTester.document("{ customerOrders(customerId: 42) { edges { node { amount } } } }")
+                .execute()
+                .errors()
+                .satisfy(errors -> {
+                    assertThat(errors).hasSize(1);
+                    assertThat(errors.get(0).getErrorType()).isEqualTo(ErrorType.NOT_FOUND);
+                    assertThat(errors.get(0).getMessage()).isEqualTo("No customer 42");
+                });
+    }
+
+    private static Order order(Long customerId) {
+        return new Order(customerId, 3_000, Instant.parse("2026-09-01T10:00:00Z"));
+    }
 }
