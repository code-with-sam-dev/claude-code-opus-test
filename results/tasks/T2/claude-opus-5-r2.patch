new file mode 100644
index 0000000..89ad66f
--- /dev/null
+++ b/src/test/java/dev/example/store/RepositoryQueryTests.java
@@ -0,0 +1,68 @@
+package dev.example.store;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import jakarta.persistence.EntityManager;
+import jakarta.persistence.EntityManagerFactory;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Map;
+import javax.sql.DataSource;
+import org.hibernate.jpa.HibernatePersistenceProvider;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.jpa.repository.support.JpaRepositoryFactory;
+import org.springframework.jdbc.datasource.AbstractDataSource;
+import org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean;
+
+// The slice tests mock the repository, so nothing there would notice a query
+// method Spring Data cannot derive or JPQL Hibernate cannot parse. This boots the
+// entity model and the repository proxy with the dialect fixed and JDBC metadata
+// switched off, which parses every query without ever opening a connection.
+class RepositoryQueryTests {
+
+    @Test
+    void everyOrderQueryIsValid() {
+        EntityManagerFactory factory = entityManagerFactory();
+        try (EntityManager em = factory.createEntityManager()) {
+            OrderRepository repository = new JpaRepositoryFactory(em)
+                    .getRepository(OrderRepository.class);
+
+            assertThat(repository).isNotNull();
+        } finally {
+            factory.close();
+        }
+    }
+
+    private static EntityManagerFactory entityManagerFactory() {
+        LocalContainerEntityManagerFactoryBean factory =
+                new LocalContainerEntityManagerFactoryBean();
+        factory.setPersistenceUnitName("offline");
+        factory.setPersistenceProvider(new HibernatePersistenceProvider());
+        factory.setPackagesToScan(Order.class.getPackageName());
+        factory.setDataSource(unusableDataSource());
+        factory.setJpaPropertyMap(Map.of(
+                "hibernate.dialect", "org.hibernate.dialect.PostgreSQLDialect",
+                "hibernate.hbm2ddl.auto", "none",
+                "hibernate.boot.allow_jdbc_metadata_access", "false"));
+        factory.afterPropertiesSet();
+        return factory.getObject();
+    }
+
+    // Any attempt to reach a database fails the test rather than hanging on a
+    // connection that is not there.
+    private static DataSource unusableDataSource() {
+        return new AbstractDataSource() {
+
+            @Override
+            public Connection getConnection() throws SQLException {
+                throw new SQLException("this test must not touch a database");
+            }
+
+            @Override
+            public Connection getConnection(String username, String password)
+                    throws SQLException {
+                return getConnection();
+            }
+        };
+    }
+}
