+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.json.JsonMapper;
+
+class OrderServiceMarkPaidTest {
+
+    private final OrderRepository orders = mock(OrderRepository.class);
+    private final OrderService service = new OrderService(orders,
+            mock(OrderLineRepository.class), mock(OutboxRepository.class),
+            new Catalog(), JsonMapper.builder().build());
+
+    @Test
+    void marksAnExistingOrderPaid() {
+        Order order = new Order("c1", "EUR", 100);
+        when(orders.findById(42L)).thenReturn(Optional.of(order));
+
+        service.markPaid(new PaymentSettled("42", "p1", 100));
+
+        assertThat(order.getStatus()).isEqualTo(OrderStatus.PAID);
+    }
+
+    @Test
+    void throwsOrderNotFoundForAnUnknownOrder() {
+        when(orders.findById(42L)).thenReturn(Optional.empty());
+
+        assertThatThrownBy(() -> service.markPaid(new PaymentSettled("42", "p1", 100)))
+                .isInstanceOf(OrderNotFoundException.class)
+                .hasMessageContaining("42");
+    }
+
+    @Test
+    void throwsOrderNotFoundForAnIdThatCannotBeAnOrder() {
+        assertThatThrownBy(() -> service.markPaid(new PaymentSettled("abc", "p1", 100)))
+                .isInstanceOf(OrderNotFoundException.class);
+        assertThatThrownBy(() -> service.markPaid(new PaymentSettled(null, "p1", 100)))
+                .isInstanceOf(OrderNotFoundException.class);
+    }
+}
diff --git a/src/test/java/dev/example/orders/PaymentSettledListenerTest.java b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
new file mode 100644
index 0000000..1e9fea4
--- /dev/null
+++ b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
@@ -0,0 +1,198 @@
+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.awaitility.Awaitility.await;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doAnswer;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Queue;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.ConsumerRecord;
+import org.apache.kafka.clients.consumer.KafkaConsumer;
+import org.apache.kafka.common.serialization.StringDeserializer;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.autoconfigure.ImportAutoConfiguration;
+import org.springframework.boot.jackson.autoconfigure.JacksonAutoConfiguration;
+import org.springframework.boot.kafka.autoconfigure.KafkaAutoConfiguration;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.dao.QueryTimeoutException;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.test.EmbeddedKafkaBroker;
+import org.springframework.kafka.test.context.EmbeddedKafka;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+
+// Only the listener, the error handling and Kafka; OrderService is a mock, so
+// no database is needed.
+@SpringBootTest(classes = {PaymentSettledListener.class, KafkaErrorHandling.class})
+@ImportAutoConfiguration({KafkaAutoConfiguration.class, JacksonAutoConfiguration.class})
+@EmbeddedKafka(topics = {"payment-settled", "payment-settled.DLT"},
+        bootstrapServersProperty = "spring.kafka.bootstrap-servers")
+class PaymentSettledListenerTest {
+
+    private static final String TOPIC = "payment-settled";
+    private static final String DLT = "payment-settled.DLT";
+
+    @MockitoBean
+    OrderService orderService;
+
+    @Autowired
+    KafkaTemplate<String, String> kafka;
+
+    @Autowired
+    EmbeddedKafkaBroker broker;
+
+    private final Queue<Call> calls = new ConcurrentLinkedQueue<>();
+    private KafkaConsumer<String, String> dlt;
+
+    record Call(String orderId, long nanos) {
+    }
+
+    @BeforeEach
+    void setUp() {
+        // How markPaid behaves depends on the order id's prefix.
+        doAnswer(invocation -> {
+            PaymentSettled event = invocation.getArgument(0);
+            String orderId = event.orderId();
+            calls.add(new Call(orderId, System.nanoTime()));
+            if (orderId.startsWith("transient-")) {
+                throw new QueryTimeoutException("database busy");
+            }
+            if (orderId.startsWith("flaky-") && attempts(orderId) < 3) {
+                throw new QueryTimeoutException("database busy");
+            }
+            if (orderId.startsWith("missing-")) {
+                throw new OrderNotFoundException(orderId);
+            }
+            return null;
+        }).when(orderService).markPaid(any());
+
+        dlt = new KafkaConsumer<>(Map.of(
+                ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, broker.getBrokersAsString(),
+                ConsumerConfig.GROUP_ID_CONFIG, "dlt-" + UUID.randomUUID(),
+                ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "earliest"),
+                new StringDeserializer(), new StringDeserializer());
+        dlt.subscribe(List.of(DLT));
+    }
+
+    @AfterEach
+    void tearDown() {
+        dlt.close();
+    }
+
+    @Test
+    void transientFailureIsRetriedWithBackoffThenDeadLettered() throws Exception {
+        String orderId = "transient-" + UUID.randomUUID();
+        String message = payment(orderId);
+
+        send(message);
+
+        ConsumerRecord<String, String> dead = awaitDeadLetter(message);
+        assertThat(dead.value()).isEqualTo(message);
+
+        List<Long> times = attemptTimes(orderId);
+        assertThat(times).hasSize(4);
+        for (int i = 1; i < times.size(); i++) {
+            assertThat(Duration.ofNanos(times.get(i) - times.get(i - 1)))
+                    .isGreaterThanOrEqualTo(Duration.ofMillis(100));
+        }
+        assertThat(Duration.ofNanos(times.getLast() - times.getFirst()))
+                .isLessThan(Duration.ofSeconds(5));
+
+        assertConsumerCarriesOn();
+        assertThat(attempts(orderId)).isEqualTo(4);
+    }
+
+    @Test
+    void transientFailureThatClearsUpIsNotDeadLettered() throws Exception {
+        String orderId = "flaky-" + UUID.randomUUID();
+        String message = payment(orderId);
+
+        send(message);
+
+        await().atMost(Duration.ofSeconds(10)).until(() -> attempts(orderId) == 3);
+        assertConsumerCarriesOn();
+        assertThat(attempts(orderId)).isEqualTo(3);
+        assertThat(deadLetters()).doesNotContain(message);
+    }
+
+    @Test
+    void paymentForAMissingOrderIsDeadLetteredWithoutRetry() throws Exception {
+        String orderId = "missing-" + UUID.randomUUID();
+        String message = payment(orderId);
+
+        send(message);
+
+        assertThat(awaitDeadLetter(message).value()).isEqualTo(message);
+        assertConsumerCarriesOn();
+        assertThat(attempts(orderId)).isEqualTo(1);
+    }
+
+    @Test
+    void invalidMessagesAreDeadLetteredWithoutCallingMarkPaid() throws Exception {
+        List<String> invalid = List.of(
+                "not json " + UUID.randomUUID(),
+                "{\"orderId\": \"" + UUID.randomUUID() + "\", \"amount\": \"lots\"}",
+                "null");
+
+        for (String message : invalid) {
+            send(message);
+        }
+
+        for (String message : invalid) {
+            assertThat(awaitDeadLetter(message).value()).isEqualTo(message);
+        }
+        assertConsumerCarriesOn();
+        assertThat(calls).hasSize(1);
+    }
+
+    // A good record sent after the failing one still gets processed.
+    private void assertConsumerCarriesOn() throws Exception {
+        String orderId = "ok-" + UUID.randomUUID();
+        send(payment(orderId));
+        await().atMost(Duration.ofSeconds(10)).until(() -> attempts(orderId) == 1);
+    }
+
+    private static String payment(String orderId) {
+        return "{\"orderId\":\"" + orderId + "\",\"paymentId\":\"p-1\",\"amount\":1000}";
+    }
+
+    private void send(String message) throws Exception {
+        kafka.send(TOPIC, message).get();
+    }
+
+    private long attempts(String orderId) {
+        return calls.stream().filter(call -> call.orderId().equals(orderId)).count();
+    }
+
+    private List<Long> attemptTimes(String orderId) {
+        return calls.stream().filter(call -> call.orderId().equals(orderId))
+                .map(Call::nanos).toList();
+    }
+
+    private final List<ConsumerRecord<String, String>> seen = new ArrayList<>();
+
+    private ConsumerRecord<String, String> awaitDeadLetter(String value) {
+        return await().atMost(Duration.ofSeconds(15)).until(() -> {
+            dlt.poll(Duration.ofMillis(200)).forEach(seen::add);
+            return seen.stream().filter(r -> value.equals(r.value())).findFirst()
+                    .orElse(null);
+        }, record -> record != null);
+    }
+
+    private List<String> deadLetters() {
+        long end = System.currentTimeMillis() + 1_000;
+        while (System.currentTimeMillis() < end) {
+            dlt.poll(Duration.ofMillis(200)).forEach(seen::add);
+        }
+        return seen.stream().map(ConsumerRecord::value).toList();
+    }
+}
