diff --git a/src/main/java/dev/example/orders/KafkaErrorHandling.java b/src/main/java/dev/example/orders/KafkaErrorHandling.java
new file mode 100644
index 0000000..64ae56b
--- /dev/null
+++ b/src/main/java/dev/example/orders/KafkaErrorHandling.java
@@ -0,0 +1,36 @@
+package dev.example.orders;
+
+import org.apache.kafka.common.TopicPartition;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.DeadLetterPublishingRecoverer;
+import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.kafka.support.ExponentialBackOffWithMaxRetries;
+import org.springframework.kafka.support.converter.ConversionException;
+
+// Spring Boot puts this error handler on every @KafkaListener. A failing record
+// is retried with a backoff: 4 attempts in total, 200, 400 and 800 ms apart.
+// Records that can never succeed are not retried. Either way the record then
+// goes, with its original value, to <topic>.DLT and the consumer moves on.
+@Configuration
+public class KafkaErrorHandling {
+
+    @Bean
+    public DefaultErrorHandler kafkaErrorHandler(KafkaTemplate<?, ?> kafka) {
+        // Partition -1 lets the producer choose, so the DLT does not need as
+        // many partitions as the source topic.
+        DeadLetterPublishingRecoverer toDlt = new DeadLetterPublishingRecoverer(kafka,
+                (record, e) -> new TopicPartition(record.topic() + ".DLT", -1));
+
+        ExponentialBackOffWithMaxRetries backOff = new ExponentialBackOffWithMaxRetries(3);
+        backOff.setInitialInterval(200);
+        backOff.setMultiplier(2);
+        backOff.setMaxInterval(1_000);
+
+        DefaultErrorHandler handler = new DefaultErrorHandler(toDlt, backOff);
+        handler.addNotRetryableExceptions(ConversionException.class,
+                OrderNotFoundException.class);
+        return handler;
+    }
+}
