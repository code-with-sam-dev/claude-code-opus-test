+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.json.JsonMapper;
+
+class OrderServiceTest {
+
+    private final OrderRepository orders = mock(OrderRepository.class);
+    private final OrderService service = new OrderService(orders,
+            mock(OrderLineRepository.class), mock(OutboxRepository.class), new Catalog(),
+            JsonMapper.builder().build());
+
+    @Test
+    void markPaidMarksAnExistingOrderAsPaid() {
+        Order order = new Order("customer-1", "EUR", 8_900);
+        when(orders.findById(7L)).thenReturn(Optional.of(order));
+
+        service.markPaid(new PaymentSettled("7", "pay-1", 8_900));
+
+        assertThat(order.getStatus()).isEqualTo(OrderStatus.PAID);
+    }
+
+    @Test
+    void markPaidThrowsOrderNotFoundForAnUnknownOrder() {
+        when(orders.findById(42L)).thenReturn(Optional.empty());
+
+        assertThatThrownBy(() -> service.markPaid(new PaymentSettled("42", "pay-1", 100)))
+                .isInstanceOf(OrderNotFoundException.class)
+                .hasMessageContaining("42")
+                .extracting("orderId").isEqualTo("42");
+    }
+}
diff --git a/src/test/java/dev/example/orders/PaymentSettledListenerTest.java b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
new file mode 100644
index 0000000..54d1494
--- /dev/null
+++ b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
@@ -0,0 +1,202 @@
+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.timeout;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.apache.kafka.clients.consumer.Consumer;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.ConsumerRecord;
+import org.apache.kafka.clients.consumer.KafkaConsumer;
+import org.apache.kafka.common.TopicPartition;
+import org.apache.kafka.common.serialization.StringDeserializer;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.autoconfigure.ImportAutoConfiguration;
+import org.springframework.boot.jackson.autoconfigure.JacksonAutoConfiguration;
+import org.springframework.boot.kafka.autoconfigure.KafkaAutoConfiguration;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Import;
+import org.springframework.dao.TransientDataAccessException;
+import org.springframework.dao.TransientDataAccessResourceException;
+import org.springframework.kafka.config.KafkaListenerEndpointRegistry;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.MessageListenerContainer;
+import org.springframework.kafka.test.EmbeddedKafkaBroker;
+import org.springframework.kafka.test.context.EmbeddedKafka;
+import org.springframework.kafka.test.utils.ContainerTestUtils;
+import org.springframework.kafka.test.utils.KafkaTestUtils;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import tools.jackson.databind.json.JsonMapper;
+
+// Drives the real listener, container and error handler against an embedded
+// broker. OrderService is a mock so no database is needed.
+@SpringBootTest(classes = PaymentSettledListenerTest.Config.class)
+@EmbeddedKafka(partitions = 1,
+        topics = {PaymentSettledListenerTest.TOPIC, PaymentSettledListenerTest.DLT})
+class PaymentSettledListenerTest {
+
+    static final String TOPIC = "payment-settled";
+    static final String DLT = "payment-settled.DLT";
+
+    private static final Duration DLT_WAIT = Duration.ofSeconds(15);
+
+    @Configuration(proxyBeanMethods = false)
+    @ImportAutoConfiguration({KafkaAutoConfiguration.class, JacksonAutoConfiguration.class})
+    @Import({KafkaConfig.class, PaymentSettledListener.class})
+    static class Config {
+    }
+
+    @MockitoBean
+    private OrderService orders;
+
+    @Autowired
+    private KafkaTemplate<String, String> kafka;
+    @Autowired
+    private KafkaListenerEndpointRegistry registry;
+    @Autowired
+    private EmbeddedKafkaBroker broker;
+    @Autowired
+    private JsonMapper json;
+
+    private Consumer<String, String> deadLetters;
+
+    @BeforeEach
+    void setUp() {
+        for (MessageListenerContainer container : registry.getListenerContainers()) {
+            ContainerTestUtils.waitForAssignment(container, 1);
+        }
+        Map<String, Object> props = KafkaTestUtils.consumerProps(broker.getBrokersAsString(),
+                "dlt-" + UUID.randomUUID(), false);
+        props.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
+        deadLetters = new KafkaConsumer<>(props);
+        // Only records dead-lettered by this test should be visible to it.
+        TopicPartition partition = new TopicPartition(DLT, 0);
+        deadLetters.assign(List.of(partition));
+        deadLetters.seekToEnd(List.of(partition));
+        deadLetters.position(partition);
+    }
+
+    @AfterEach
+    void tearDown() {
+        deadLetters.close();
+    }
+
+    @Test
+    void transientFailureIsRetriedWithBackoffThenDeadLettered() throws Exception {
+        List<Long> attemptNanos = new CopyOnWriteArrayList<>();
+        doAnswer(invocation -> {
+            attemptNanos.add(System.nanoTime());
+            throw new TransientDataAccessResourceException("connection reset");
+        }).when(orders).markPaid(any());
+        PaymentSettled event = new PaymentSettled("1", "pay-1", 8_900);
+        String value = json.writeValueAsString(event);
+
+        send(value);
+
+        ConsumerRecord<String, String> dead = awaitDeadLetter();
+        assertThat(dead.value()).isEqualTo(value);
+        verify(orders, times(4)).markPaid(event);
+        assertThat(attemptNanos).hasSize(4);
+        for (int i = 1; i < attemptNanos.size(); i++) {
+            long gapMillis = TimeUnit.NANOSECONDS.toMillis(
+                    attemptNanos.get(i) - attemptNanos.get(i - 1));
+            assertThat(gapMillis)
+                    .as("gap before attempt %d", i + 1)
+                    .isGreaterThanOrEqualTo(100);
+        }
+        long totalMillis = TimeUnit.NANOSECONDS.toMillis(
+                attemptNanos.get(3) - attemptNanos.get(0));
+        assertThat(totalMillis).isLessThan(5_000);
+    }
+
+    @Test
+    void transientFailureThatClearsIsNotDeadLettered() throws Exception {
+        AtomicInteger calls = new AtomicInteger();
+        doAnswer(invocation -> {
+            if (calls.incrementAndGet() < 3) {
+                throw new TransientDataAccessResourceException("deadlock");
+            }
+            return null;
+        }).when(orders).markPaid(any());
+        PaymentSettled event = new PaymentSettled("2", "pay-2", 2_500);
+
+        send(json.writeValueAsString(event));
+
+        verify(orders, timeout(5_000).times(3)).markPaid(event);
+        assertThat(deadLetters.poll(Duration.ofSeconds(1)).isEmpty()).isTrue();
+        verify(orders, times(3)).markPaid(any());
+    }
+
+    @Test
+    void transientDataAccessExceptionSubtypesAreRetried() throws Exception {
+        doThrow(new TransientDataAccessException("custom transient") { })
+                .when(orders).markPaid(any());
+        PaymentSettled event = new PaymentSettled("3", "pay-3", 100);
+        String value = json.writeValueAsString(event);
+
+        send(value);
+
+        assertThat(awaitDeadLetter().value()).isEqualTo(value);
+        verify(orders, times(4)).markPaid(event);
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"this is not json", "[]"})
+    void unparseableMessageGoesStraightToDeadLetterTopic(String garbage) throws Exception {
+        send(garbage);
+
+        assertThat(awaitDeadLetter().value()).isEqualTo(garbage);
+        verify(orders, never()).markPaid(any());
+
+        // The consumer is still alive and processes the next record.
+        PaymentSettled next = new PaymentSettled("4", "pay-4", 100);
+        send(json.writeValueAsString(next));
+        verify(orders, timeout(5_000)).markPaid(next);
+        verify(orders, times(1)).markPaid(any());
+    }
+
+    @Test
+    void unknownOrderGoesStraightToDeadLetterTopicWithoutRetry() throws Exception {
+        PaymentSettled unknown = new PaymentSettled("999", "pay-999", 100);
+        PaymentSettled known = new PaymentSettled("5", "pay-5", 100);
+        doThrow(new OrderNotFoundException("999")).when(orders).markPaid(unknown);
+        String value = json.writeValueAsString(unknown);
+
+        send(value);
+
+        assertThat(awaitDeadLetter().value()).isEqualTo(value);
+        verify(orders, times(1)).markPaid(unknown);
+
+        // The consumer is still alive, and the failed record was not retried.
+        send(json.writeValueAsString(known));
+        verify(orders, timeout(5_000)).markPaid(known);
+        verify(orders, times(1)).markPaid(unknown);
+        verify(orders, times(2)).markPaid(any());
+    }
+
+    private void send(String value) throws Exception {
+        kafka.send(TOPIC, value).get(10, TimeUnit.SECONDS);
+    }
+
+    private ConsumerRecord<String, String> awaitDeadLetter() {
+        return KafkaTestUtils.getSingleRecord(deadLetters, DLT, DLT_WAIT);
+    }
+}
