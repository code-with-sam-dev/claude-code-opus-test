+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.when;
+
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+@ExtendWith(MockitoExtension.class)
+class OrderServiceMarkPaidTest {
+
+    @Mock
+    private OrderRepository orders;
+
+    private OrderService service() {
+        return new OrderService(orders, null, null, null, null);
+    }
+
+    @Test
+    void marksTheOrderPaid() {
+        Order order = new Order("cust-1", "EUR", 1250);
+        when(orders.findById(7L)).thenReturn(Optional.of(order));
+
+        service().markPaid(new PaymentSettled("7", "pay-7", 1250));
+
+        assertThat(order.getStatus()).isEqualTo(OrderStatus.PAID);
+    }
+
+    @Test
+    void throwsOrderNotFoundWhenTheOrderIsGone() {
+        when(orders.findById(404L)).thenReturn(Optional.empty());
+
+        assertThatExceptionOfType(OrderNotFoundException.class)
+                .isThrownBy(() -> service().markPaid(
+                        new PaymentSettled("404", "pay-404", 500)))
+                .satisfies(e -> assertThat(e.orderId()).isEqualTo("404"));
+    }
+
+    @Test
+    void throwsOrderNotFoundWhenTheOrderIdIsNotOneOfOurs() {
+        assertThatExceptionOfType(OrderNotFoundException.class)
+                .isThrownBy(() -> service().markPaid(
+                        new PaymentSettled("not-an-id", "pay-x", 500)));
+
+        verifyNoInteractions(orders);
+    }
+}
diff --git a/src/test/java/dev/example/orders/PaymentSettledListenerTest.java b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
new file mode 100644
index 0000000..747fac2
--- /dev/null
+++ b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
@@ -0,0 +1,241 @@
+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.fail;
+import static org.awaitility.Awaitility.await;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.reset;
+import static org.mockito.Mockito.verify;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CopyOnWriteArrayList;
+import org.apache.kafka.clients.consumer.Consumer;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.ConsumerRecord;
+import org.apache.kafka.common.serialization.StringDeserializer;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.autoconfigure.ImportAutoConfiguration;
+import org.springframework.boot.kafka.autoconfigure.KafkaAutoConfiguration;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Import;
+import org.springframework.dao.TransientDataAccessResourceException;
+import org.springframework.kafka.core.DefaultKafkaConsumerFactory;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.test.EmbeddedKafkaBroker;
+import org.springframework.kafka.test.context.EmbeddedKafka;
+import tools.jackson.databind.json.JsonMapper;
+
+// Drives the real listener over an embedded broker: what it does to a record is
+// the container's error handler talking, so it is only observable end to end.
+@SpringBootTest(classes = PaymentSettledListenerTest.KafkaOnly.class,
+        properties = {
+                "spring.kafka.bootstrap-servers=${spring.embedded.kafka.brokers}",
+                "spring.kafka.consumer.auto-offset-reset=earliest"
+        })
+@EmbeddedKafka(topics = {PaymentSettledListenerTest.TOPIC, PaymentSettledListenerTest.DLT},
+        partitions = 1)
+class PaymentSettledListenerTest {
+
+    static final String TOPIC = "payment-settled";
+    static final String DLT = "payment-settled.DLT";
+
+    private static final int EXPECTED_ATTEMPTS = 4;
+    private static final long MIN_BACKOFF_MS = 100;
+    private static final long MAX_SEQUENCE_MS = 5_000;
+
+    // Time to give the broker plus container a record; generous, and every wait
+    // that matters is bounded by an assertion, not by this.
+    private static final Duration PATIENCE = Duration.ofSeconds(20);
+
+    @Autowired
+    private OrderService orders;
+
+    @Autowired
+    private KafkaTemplate<String, String> kafka;
+
+    @Autowired
+    private EmbeddedKafkaBroker broker;
+
+    private Consumer<String, String> deadLetters;
+    private final List<ConsumerRecord<String, String>> drained = new ArrayList<>();
+
+    @BeforeEach
+    void subscribeToDeadLetters() {
+        reset(orders);
+        Map<String, Object> props = new HashMap<>();
+        props.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, broker.getBrokersAsString());
+        props.put(ConsumerConfig.GROUP_ID_CONFIG, "dlt-reader-" + UUID.randomUUID());
+        props.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "earliest");
+        deadLetters = new DefaultKafkaConsumerFactory<>(props,
+                new StringDeserializer(), new StringDeserializer()).createConsumer();
+        deadLetters.subscribe(List.of(DLT));
+        deadLetters.poll(Duration.ofMillis(500));
+    }
+
+    @AfterEach
+    void closeDeadLetters() {
+        deadLetters.close();
+    }
+
+    @Test
+    void retriesTransientFailuresWithBackoffAndThenDeadLetters() {
+        List<Long> attempts = new CopyOnWriteArrayList<>();
+        doAnswer(invocation -> {
+            attempts.add(System.nanoTime());
+            throw new TransientDataAccessResourceException("connection reset");
+        }).when(orders).markPaid(any());
+
+        String message = paymentFor("41");
+        send("order-41", message);
+
+        ConsumerRecord<String, String> dead = awaitDeadLetter(message);
+        assertThat(dead.key()).isEqualTo("order-41");
+
+        // The recoverer runs after the last attempt, so the count is final here;
+        // hold it for a moment to catch an eleventh-hour redelivery.
+        await().during(Duration.ofMillis(500)).atMost(Duration.ofSeconds(3))
+                .untilAsserted(() -> assertThat(attempts).hasSize(EXPECTED_ATTEMPTS));
+
+        for (int i = 1; i < attempts.size(); i++) {
+            long gapMs = millisBetween(attempts.get(i - 1), attempts.get(i));
+            assertThat(gapMs)
+                    .as("gap before attempt %d", i + 1)
+                    .isGreaterThanOrEqualTo(MIN_BACKOFF_MS);
+        }
+        long sequenceMs = millisBetween(attempts.get(0), attempts.get(attempts.size() - 1));
+        assertThat(sequenceMs).as("whole retry sequence").isLessThan(MAX_SEQUENCE_MS);
+    }
+
+    @Test
+    void deadLettersUnreadablePayloadsWithoutRetrying() {
+        String notJson = "{ this is not json";
+        String wrongShape = "{\"orderId\":\"12\",\"paymentId\":\"pay-12\",\"amount\":\"lots\"}";
+
+        send("order-bad", notJson);
+        send("order-12", wrongShape);
+
+        assertThat(awaitDeadLetter(notJson).value()).isEqualTo(notJson);
+        assertThat(awaitDeadLetter(wrongShape).value()).isEqualTo(wrongShape);
+        verify(orders, never()).markPaid(any());
+    }
+
+    @Test
+    void deadLettersPaymentsForUnknownOrdersWithoutRetrying() {
+        List<Long> attempts = new CopyOnWriteArrayList<>();
+        doAnswer(invocation -> {
+            attempts.add(System.nanoTime());
+            throw new OrderNotFoundException("404");
+        }).when(orders).markPaid(any());
+
+        String message = paymentFor("404");
+        send("order-404", message);
+
+        assertThat(awaitDeadLetter(message).value()).isEqualTo(message);
+        await().during(Duration.ofMillis(500)).atMost(Duration.ofSeconds(3))
+                .untilAsserted(() -> assertThat(attempts).hasSize(1));
+    }
+
+    @Test
+    void marksTheOrderPaidAndDeadLettersNothing() {
+        String message = paymentFor("5");
+
+        send("order-5", message);
+
+        await().atMost(PATIENCE).untilAsserted(() ->
+                verify(orders).markPaid(new PaymentSettled("5", "pay-5", 1250)));
+        assertNoDeadLetter(message);
+    }
+
+    @Test
+    void carriesOnWithTheNextRecordAfterAFailure() {
+        String poison = "]]not json[[";
+        String good = paymentFor("6");
+
+        send("order-poison", poison);
+        send("order-6", good);
+
+        await().atMost(PATIENCE).untilAsserted(() ->
+                verify(orders).markPaid(new PaymentSettled("6", "pay-6", 1250)));
+        assertThat(awaitDeadLetter(poison).value()).isEqualTo(poison);
+        assertNoDeadLetter(good);
+    }
+
+    private static String paymentFor(String orderId) {
+        return "{\"orderId\":\"" + orderId + "\",\"paymentId\":\"pay-" + orderId
+                + "\",\"amount\":1250}";
+    }
+
+    private void send(String key, String message) {
+        kafka.send(TOPIC, key, message);
+        kafka.flush();
+    }
+
+    private ConsumerRecord<String, String> awaitDeadLetter(String value) {
+        long deadline = System.nanoTime() + PATIENCE.toNanos();
+        do {
+            ConsumerRecord<String, String> match = findDrained(value);
+            if (match != null) {
+                return match;
+            }
+            drain(Duration.ofMillis(500));
+        } while (System.nanoTime() < deadline);
+        return fail("no record with value <%s> on %s", value, DLT);
+    }
+
+    private void assertNoDeadLetter(String value) {
+        drain(Duration.ofSeconds(2));
+        assertThat(findDrained(value))
+                .as("record <%s> should not be on %s", value, DLT)
+                .isNull();
+    }
+
+    private void drain(Duration timeout) {
+        deadLetters.poll(timeout).forEach(drained::add);
+    }
+
+    private ConsumerRecord<String, String> findDrained(String value) {
+        return drained.stream()
+                .filter(record -> value.equals(record.value()))
+                .findFirst()
+                .orElse(null);
+    }
+
+    private static long millisBetween(long fromNanos, long toNanos) {
+        return (toNanos - fromNanos) / 1_000_000;
+    }
+
+    // The listener and its error handling, without the database half of the app.
+    @Configuration(proxyBeanMethods = false)
+    @ImportAutoConfiguration(KafkaAutoConfiguration.class)
+    @Import(KafkaErrorHandlingConfig.class)
+    static class KafkaOnly {
+
+        @Bean
+        JsonMapper jsonMapper() {
+            return JsonMapper.builder().build();
+        }
+
+        @Bean
+        OrderService orderService() {
+            return mock(OrderService.class);
+        }
+
+        @Bean
+        PaymentSettledListener paymentSettledListener(OrderService orders, JsonMapper json) {
+            return new PaymentSettledListener(orders, json);
+        }
+    }
+}
