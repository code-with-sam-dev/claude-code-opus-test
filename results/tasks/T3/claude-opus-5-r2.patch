@@ -0,0 +1,16 @@
+package dev.example.orders;
+
+// No amount of retrying makes the order appear, so callers treat this as final.
+public class OrderNotFoundException extends RuntimeException {
+
+    private final String orderId;
+
+    public OrderNotFoundException(String orderId) {
+        super("No order " + orderId);
+        this.orderId = orderId;
+    }
+
+    public String orderId() {
+        return orderId;
+    }
+}
diff --git a/src/main/java/dev/example/orders/OrderService.java b/src/main/java/dev/example/orders/OrderService.java
index d98334d..89d3427 100644
--- a/src/main/java/dev/example/orders/OrderService.java
+++ b/src/main/java/dev/example/orders/OrderService.java
@@ -46,9 +46,17 @@ public class OrderService {
 
     @Transactional
     public void markPaid(PaymentSettled event) {
-        Order order = orders.findById(Long.valueOf(event.orderId()))
-                .orElseThrow(() ->
-                        new IllegalStateException("No order " + event.orderId()));
+        Order order = orders.findById(orderIdOf(event))
+                .orElseThrow(() -> new OrderNotFoundException(event.orderId()));
         order.markPaid();
     }
+
+    // An id that is not one of ours names no order either.
+    private static Long orderIdOf(PaymentSettled event) {
+        try {
+            return Long.valueOf(event.orderId());
+        } catch (NumberFormatException | NullPointerException e) {
+            throw new OrderNotFoundException(event.orderId());
+        }
+    }
 }
