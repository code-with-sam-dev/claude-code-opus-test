+package dev.example.orders;
+
+import org.apache.kafka.common.TopicPartition;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.DeadLetterPublishingRecoverer;
+import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.util.backoff.FixedBackOff;
+import tools.jackson.core.JacksonException;
+
+// How consumers fail: a few spaced-out attempts for anything that may pass on a
+// retry, straight to the dead letter topic for anything that cannot. Either way
+// the record leaves the partition so the next one gets a turn.
+@Configuration(proxyBeanMethods = false)
+public class KafkaErrorHandlingConfig {
+
+    static final int MAX_ATTEMPTS = 4;
+    static final long RETRY_INTERVAL_MS = 200L;
+
+    @Bean
+    DefaultErrorHandler kafkaErrorHandler(KafkaTemplate<String, String> kafka) {
+        // <topic>.DLT, same partition, original key and value.
+        DeadLetterPublishingRecoverer deadLetters = new DeadLetterPublishingRecoverer(kafka,
+                (record, exception) ->
+                        new TopicPartition(record.topic() + ".DLT", record.partition()));
+        DefaultErrorHandler handler = new DefaultErrorHandler(deadLetters,
+                new FixedBackOff(RETRY_INTERVAL_MS, MAX_ATTEMPTS - 1));
+        // A payload we cannot read, or an order that does not exist, reads the
+        // same on the tenth attempt as on the first.
+        handler.addNotRetryableExceptions(JacksonException.class,
+                OrderNotFoundException.class);
+        return handler;
+    }
+}
