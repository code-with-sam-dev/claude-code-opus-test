+type Order @key(fields: "id") {
+    id: ID!
+    customerId: ID!
+    currency: String!
+    total: Int!
+    status: OrderStatus!
+    lines: [OrderLine!]!
+}
+
+type OrderLine {
+    sku: String!
+    quantity: Int!
+    unitPrice: Int!
+}
+
+enum OrderStatus {
+    PLACED
+    PAID
+}
+
+input PlaceOrderInput {
+    customerId: ID!
+    currency: String!
+    lines: [LineInput!]!
+}
+
+input LineInput {
+    sku: String!
+    quantity: Int!
+}
