@@ -0,0 +1,38 @@
+package dev.example.orders;
+
+import org.apache.kafka.common.TopicPartition;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.kafka.listener.DeadLetterPublishingRecoverer;
+import org.springframework.util.backoff.FixedBackOff;
+import tools.jackson.core.JacksonException;
+
+@Configuration
+public class KafkaErrorHandlingConfig {
+
+    // One attempt plus MAX_RETRIES more, RETRY_INTERVAL apart.
+    static final long RETRY_INTERVAL = 200L;
+    static final long MAX_RETRIES = 3L;
+
+    // Spelled out because the recoverer's own default is "-dlt".
+    static final String DLT_SUFFIX = ".DLT";
+
+    /*
+     * Transient failures get a few spaced out attempts; failures that cannot get
+     * better - a message we cannot parse, an order that does not exist - go
+     * straight to the dead letter topic. Either way the record ends up on
+     * <topic>.DLT with its original value and the container moves on.
+     */
+    @Bean
+    DefaultErrorHandler kafkaErrorHandler(KafkaTemplate<?, ?> template) {
+        DeadLetterPublishingRecoverer recoverer = new DeadLetterPublishingRecoverer(template,
+                (record, exception) ->
+                        new TopicPartition(record.topic() + DLT_SUFFIX, record.partition()));
+        DefaultErrorHandler handler = new DefaultErrorHandler(recoverer,
+                new FixedBackOff(RETRY_INTERVAL, MAX_RETRIES));
+        handler.addNotRetryableExceptions(JacksonException.class, OrderNotFoundException.class);
+        return handler;
+    }
+}
