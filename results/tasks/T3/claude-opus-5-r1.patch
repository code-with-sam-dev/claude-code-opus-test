+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.json.JsonMapper;
+
+class OrderServiceMarkPaidTest {
+
+    private final OrderRepository orders = mock(OrderRepository.class);
+    private final OrderService service = new OrderService(orders,
+            mock(OrderLineRepository.class), mock(OutboxRepository.class),
+            mock(Catalog.class), JsonMapper.builder().build());
+
+    @Test
+    void marksAKnownOrderAsPaid() {
+        Order order = new Order("cust-1", "EUR", 2500);
+        when(orders.findById(7L)).thenReturn(Optional.of(order));
+
+        service.markPaid(new PaymentSettled("7", "pay-7", 2500));
+
+        assertThat(order.getStatus()).isEqualTo(OrderStatus.PAID);
+    }
+
+    @Test
+    void rejectsAPaymentForAnOrderThatDoesNotExist() {
+        when(orders.findById(4040L)).thenReturn(Optional.empty());
+
+        assertThatExceptionOfType(OrderNotFoundException.class)
+                .isThrownBy(() -> service.markPaid(new PaymentSettled("4040", "pay-4040", 100)))
+                .withMessageContaining("4040");
+    }
+}
diff --git a/src/test/java/dev/example/orders/PaymentSettledListenerTest.java b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
new file mode 100644
index 0000000..05d1f02
--- /dev/null
+++ b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
@@ -0,0 +1,281 @@
+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.reset;
+import static org.mockito.Mockito.verify;
+
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.function.BooleanSupplier;
+import org.apache.kafka.clients.consumer.Consumer;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.ConsumerRecord;
+import org.apache.kafka.clients.consumer.ConsumerRecords;
+import org.apache.kafka.common.TopicPartition;
+import org.apache.kafka.common.serialization.StringDeserializer;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.autoconfigure.ImportAutoConfiguration;
+import org.springframework.boot.jackson.autoconfigure.JacksonAutoConfiguration;
+import org.springframework.boot.kafka.autoconfigure.KafkaAutoConfiguration;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Import;
+import org.springframework.dao.TransientDataAccessResourceException;
+import org.springframework.kafka.config.KafkaListenerEndpointRegistry;
+import org.springframework.kafka.core.DefaultKafkaConsumerFactory;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.MessageListenerContainer;
+import org.springframework.kafka.test.EmbeddedKafkaBroker;
+import org.springframework.kafka.test.context.EmbeddedKafka;
+import org.springframework.kafka.test.utils.ContainerTestUtils;
+
+/*
+ * The listener, its error handler and a real broker, with OrderService mocked so a
+ * test can decide how markPaid fails. No database is involved: the context holds
+ * only Jackson, Kafka and the listener.
+ */
+@SpringBootTest(classes = PaymentSettledListenerTest.ListenerOnlyApp.class,
+        properties = {
+                "spring.kafka.bootstrap-servers=${spring.embedded.kafka.brokers}",
+                "spring.kafka.consumer.auto-offset-reset=earliest"
+        })
+@EmbeddedKafka(topics = { PaymentSettledListenerTest.TOPIC, PaymentSettledListenerTest.DLT },
+        partitions = 1)
+class PaymentSettledListenerTest {
+
+    static final String TOPIC = "payment-settled";
+    static final String DLT = "payment-settled.DLT";
+
+    private static final Duration POLL_TIMEOUT = Duration.ofSeconds(15);
+
+    @Configuration
+    @ImportAutoConfiguration({ JacksonAutoConfiguration.class, KafkaAutoConfiguration.class })
+    @Import({ PaymentSettledListener.class, KafkaErrorHandlingConfig.class })
+    static class ListenerOnlyApp {
+
+        @Bean
+        OrderService orders() {
+            return mock(OrderService.class);
+        }
+    }
+
+    @Autowired
+    private OrderService orders;
+
+    @Autowired
+    private KafkaTemplate<String, String> template;
+
+    @Autowired
+    private KafkaListenerEndpointRegistry registry;
+
+    @Autowired
+    private EmbeddedKafkaBroker broker;
+
+    private Consumer<String, String> deadLetters;
+
+    @BeforeEach
+    void setUp() {
+        reset(orders);
+        for (MessageListenerContainer container : registry.getListenerContainers()) {
+            ContainerTestUtils.waitForAssignment(container, 1);
+        }
+        // Start reading the dead letter topic where this test begins, so records
+        // left behind by earlier tests are not picked up.
+        deadLetters = dltConsumer();
+    }
+
+    @AfterEach
+    void tearDown() {
+        deadLetters.close();
+    }
+
+    @Test
+    void transientFailureIsRetriedWithBackoffAndThenDeadLettered() {
+        List<Long> attempts = failMarkPaidWith(new TransientDataAccessResourceException("db busy"));
+        String message = """
+                {"orderId":"41","paymentId":"pay-41","amount":1500}""";
+
+        send(message);
+        ConsumerRecord<String, String> dead = nextDeadLetter();
+        long finishedAt = System.nanoTime();
+
+        assertThat(dead.value()).isEqualTo(message);
+        assertThat(attempts).hasSize(4);
+        for (int i = 1; i < attempts.size(); i++) {
+            assertThat(Duration.ofNanos(attempts.get(i) - attempts.get(i - 1)))
+                    .as("pause before attempt %d", i + 1)
+                    .isGreaterThanOrEqualTo(Duration.ofMillis(100));
+        }
+        assertThat(Duration.ofNanos(finishedAt - attempts.get(0)))
+                .as("time from first attempt to dead letter")
+                .isLessThan(Duration.ofSeconds(5));
+
+        // And it stays at four attempts once the record has been dead lettered.
+        assertThat(stays(() -> attempts.size() == 4)).isTrue();
+    }
+
+    @Test
+    void unparseableMessageIsDeadLetteredWithoutRetrying() {
+        List<Long> attempts = failMarkPaidWith(new TransientDataAccessResourceException("db busy"));
+        String message = "this is not json";
+
+        send(message);
+        ConsumerRecord<String, String> dead = nextDeadLetter();
+
+        assertThat(dead.value()).isEqualTo(message);
+        assertThat(attempts).as("markPaid is never reached for an unparseable record").isEmpty();
+    }
+
+    @Test
+    void unknownOrderIsDeadLetteredWithoutRetrying() {
+        List<Long> attempts = failMarkPaidWith(new OrderNotFoundException("4040"));
+        String message = """
+                {"orderId":"4040","paymentId":"pay-4040","amount":900}""";
+
+        send(message);
+        ConsumerRecord<String, String> dead = nextDeadLetter();
+
+        assertThat(dead.value()).isEqualTo(message);
+        assertThat(attempts).hasSize(1);
+        assertThat(stays(() -> attempts.size() == 1)).isTrue();
+    }
+
+    @Test
+    void settledPaymentIsHandedToOrderService() {
+        send("""
+                {"orderId":"7","paymentId":"pay-7","amount":2500}""");
+
+        ArgumentCaptor<PaymentSettled> captor = ArgumentCaptor.forClass(PaymentSettled.class);
+        waitFor(() -> {
+            verify(orders).markPaid(captor.capture());
+            return true;
+        });
+        assertThat(captor.getValue())
+                .isEqualTo(new PaymentSettled("7", "pay-7", 2500L));
+        assertThat(deadLetters.poll(Duration.ofSeconds(1)).isEmpty())
+                .as("nothing is dead lettered")
+                .isTrue();
+    }
+
+    /*
+     * The listener carries on with the next record after a failure: a record that is
+     * dead lettered does not stop the one behind it from being processed.
+     */
+    @Test
+    void consumerCarriesOnAfterADeadLetteredRecord() {
+        failMarkPaidWith(new OrderNotFoundException("5050"));
+
+        send("""
+                {"orderId":"5050","paymentId":"pay-5050","amount":100}""");
+        nextDeadLetter();
+
+        reset(orders);
+        send("""
+                {"orderId":"8","paymentId":"pay-8","amount":300}""");
+        waitFor(() -> {
+            verify(orders).markPaid(new PaymentSettled("8", "pay-8", 300L));
+            return true;
+        });
+    }
+
+    /* Publishes to payment-settled and waits for the broker to acknowledge it. */
+    private void send(String value) {
+        try {
+            template.send(TOPIC, value).get(30, TimeUnit.SECONDS);
+        }
+        catch (InterruptedException ex) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(ex);
+        }
+        catch (ExecutionException | TimeoutException ex) {
+            throw new IllegalStateException("could not publish to " + TOPIC, ex);
+        }
+    }
+
+    /* Makes markPaid throw, and hands back the timestamp of every call it receives. */
+    private List<Long> failMarkPaidWith(RuntimeException failure) {
+        List<Long> attempts = new CopyOnWriteArrayList<>();
+        doAnswer(invocation -> {
+            attempts.add(System.nanoTime());
+            throw failure;
+        }).when(orders).markPaid(any());
+        return attempts;
+    }
+
+    private ConsumerRecord<String, String> nextDeadLetter() {
+        ConsumerRecords<String, String> records = deadLetters.poll(POLL_TIMEOUT);
+        assertThat(records.count()).as("records on %s", DLT).isEqualTo(1);
+        return records.iterator().next();
+    }
+
+    private Consumer<String, String> dltConsumer() {
+        Map<String, Object> props = Map.of(
+                ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, broker.getBrokersAsString(),
+                ConsumerConfig.GROUP_ID_CONFIG, "dlt-probe-" + UUID.randomUUID(),
+                ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false,
+                ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class,
+                ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
+        Consumer<String, String> consumer =
+                new DefaultKafkaConsumerFactory<String, String>(props).createConsumer();
+        TopicPartition partition = new TopicPartition(DLT, 0);
+        consumer.assign(List.of(partition));
+        consumer.seekToEnd(List.of(partition));
+        consumer.position(partition);
+        return consumer;
+    }
+
+    /* Waits up to POLL_TIMEOUT for the condition, retrying whatever it throws. */
+    private void waitFor(BooleanSupplier condition) {
+        long deadline = System.nanoTime() + POLL_TIMEOUT.toNanos();
+        Throwable last = null;
+        while (System.nanoTime() < deadline) {
+            try {
+                if (condition.getAsBoolean()) {
+                    return;
+                }
+                last = null;
+            }
+            catch (AssertionError | RuntimeException ex) {
+                last = ex;
+            }
+            sleep(50);
+        }
+        if (last instanceof AssertionError error) {
+            throw error;
+        }
+        if (last instanceof RuntimeException ex) {
+            throw ex;
+        }
+        throw new AssertionError("condition was not met within " + POLL_TIMEOUT);
+    }
+
+    /* True if the condition still holds half a second from now. */
+    private boolean stays(BooleanSupplier condition) {
+        sleep(500);
+        return condition.getAsBoolean();
+    }
+
+    private void sleep(long millis) {
+        try {
+            Thread.sleep(millis);
+        }
+        catch (InterruptedException ex) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(ex);
+        }
+    }
+}
