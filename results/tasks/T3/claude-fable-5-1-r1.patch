+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.when;
+
+import java.util.Optional;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import tools.jackson.databind.json.JsonMapper;
+
+@ExtendWith(MockitoExtension.class)
+class OrderServiceTest {
+
+    @Mock OrderRepository orders;
+    @Mock OrderLineRepository lines;
+    @Mock OutboxRepository outbox;
+    @Mock Catalog catalog;
+
+    OrderService service;
+
+    @BeforeEach
+    void setUp() {
+        service = new OrderService(orders, lines, outbox, catalog, JsonMapper.builder().build());
+    }
+
+    @Test
+    void markPaidThrowsOrderNotFoundForUnknownOrder() {
+        when(orders.findById(42L)).thenReturn(Optional.empty());
+
+        assertThatThrownBy(() -> service.markPaid(new PaymentSettled("42", "pay-1", 500)))
+                .isInstanceOf(OrderNotFoundException.class)
+                .hasMessageContaining("42");
+    }
+
+    @Test
+    void markPaidMarksExistingOrderPaid() {
+        Order order = new Order("customer-1", "EUR", 500);
+        when(orders.findById(7L)).thenReturn(Optional.of(order));
+
+        service.markPaid(new PaymentSettled("7", "pay-1", 500));
+
+        assertThat(order.getStatus()).isEqualTo(OrderStatus.PAID);
+    }
+}
diff --git a/src/test/java/dev/example/orders/PaymentSettledListenerTest.java b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
new file mode 100644
index 0000000..00f518b
--- /dev/null
+++ b/src/test/java/dev/example/orders/PaymentSettledListenerTest.java
@@ -0,0 +1,198 @@
+package dev.example.orders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.awaitility.Awaitility.await;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.doNothing;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import org.apache.kafka.clients.consumer.Consumer;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.ConsumerRecord;
+import org.apache.kafka.clients.consumer.KafkaConsumer;
+import org.apache.kafka.common.serialization.StringDeserializer;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.autoconfigure.ImportAutoConfiguration;
+import org.springframework.boot.jackson.autoconfigure.JacksonAutoConfiguration;
+import org.springframework.boot.kafka.autoconfigure.KafkaAutoConfiguration;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Import;
+import org.springframework.dao.TransientDataAccessResourceException;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.test.EmbeddedKafkaBroker;
+import org.springframework.kafka.test.context.EmbeddedKafka;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import tools.jackson.databind.json.JsonMapper;
+
+// Runs the real listener, the real Kafka error handling and Spring Boot's Kafka
+// auto-configuration against an embedded broker. OrderService is a mock so no
+// database is needed.
+@SpringBootTest
+@EmbeddedKafka(partitions = 1, topics = {PaymentSettledListenerTest.TOPIC, PaymentSettledListenerTest.DLT},
+        bootstrapServersProperty = "spring.kafka.bootstrap-servers")
+class PaymentSettledListenerTest {
+
+    static final String TOPIC = "payment-settled";
+    static final String DLT = "payment-settled.DLT";
+
+    static final Duration WAIT = Duration.ofSeconds(15);
+    static final Duration QUIET = Duration.ofSeconds(2);
+
+    @Configuration(proxyBeanMethods = false)
+    @ImportAutoConfiguration({KafkaAutoConfiguration.class, JacksonAutoConfiguration.class})
+    @Import({PaymentSettledListener.class, KafkaErrorHandlingConfig.class})
+    static class Config {
+    }
+
+    @MockitoBean OrderService orders;
+    @Autowired KafkaTemplate<String, String> kafka;
+    @Autowired EmbeddedKafkaBroker broker;
+    @Autowired JsonMapper json;
+
+    Consumer<String, String> deadLetters;
+
+    @BeforeEach
+    void subscribeToDeadLetterTopic() {
+        Map<String, Object> props = new HashMap<>();
+        props.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, broker.getBrokersAsString());
+        props.put(ConsumerConfig.GROUP_ID_CONFIG, "dlt-" + UUID.randomUUID());
+        props.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "earliest");
+        props.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false);
+        props.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
+        props.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
+        deadLetters = new KafkaConsumer<>(props);
+        broker.consumeFromAnEmbeddedTopic(deadLetters, DLT);
+    }
+
+    @AfterEach
+    void closeDeadLetterConsumer() {
+        deadLetters.close();
+    }
+
+    @Test
+    void transientFailureIsRetriedWithBackoffThenDeadLettered() throws Exception {
+        PaymentSettled event = new PaymentSettled("1", "pay-1", 500);
+        List<Long> attempts = Collections.synchronizedList(new ArrayList<>());
+        doAnswer(invocation -> {
+            attempts.add(System.nanoTime());
+            throw new TransientDataAccessResourceException("database is away");
+        }).when(orders).markPaid(event);
+
+        String value = send(event);
+
+        ConsumerRecord<String, String> dead = awaitDeadLetter(value);
+        assertThat(dead.value()).isEqualTo(value);
+        assertThat(attempts).hasSize(4);
+        for (int i = 1; i < attempts.size(); i++) {
+            long gapMs = TimeUnit.NANOSECONDS.toMillis(attempts.get(i) - attempts.get(i - 1));
+            assertThat(gapMs).as("gap before attempt %d", i + 1).isGreaterThanOrEqualTo(100);
+        }
+        long totalMs = TimeUnit.NANOSECONDS.toMillis(attempts.get(3) - attempts.get(0));
+        assertThat(totalMs).isLessThan(5000);
+
+        assertNextRecordIsProcessed("101");
+    }
+
+    @Test
+    void transientFailureThatRecoversIsNotDeadLettered() throws Exception {
+        PaymentSettled event = new PaymentSettled("2", "pay-2", 500);
+        doThrow(new TransientDataAccessResourceException("blip"))
+                .doThrow(new TransientDataAccessResourceException("blip"))
+                .doNothing()
+                .when(orders).markPaid(event);
+
+        String value = send(event);
+
+        await().atMost(WAIT).untilAsserted(() -> verify(orders, times(3)).markPaid(event));
+        assertNoDeadLetter(value);
+    }
+
+    @Test
+    void invalidJsonIsDeadLetteredWithoutRetry() throws Exception {
+        String value = "{\"orderId\": ";
+
+        kafka.send(TOPIC, value).get(10, TimeUnit.SECONDS);
+
+        ConsumerRecord<String, String> dead = awaitDeadLetter(value);
+        assertThat(dead.value()).isEqualTo(value);
+        verify(orders, never()).markPaid(any());
+
+        assertNextRecordIsProcessed("103");
+    }
+
+    @Test
+    void unknownOrderIsDeadLetteredWithoutRetry() throws Exception {
+        PaymentSettled event = new PaymentSettled("4", "pay-4", 500);
+        doThrow(new OrderNotFoundException("4")).when(orders).markPaid(event);
+
+        String value = send(event);
+
+        ConsumerRecord<String, String> dead = awaitDeadLetter(value);
+        assertThat(dead.value()).isEqualTo(value);
+        assertNextRecordIsProcessed("104");
+        // The next record went through, so no further attempt on this one can
+        // still be pending.
+        verify(orders, times(1)).markPaid(event);
+    }
+
+    private String send(PaymentSettled event) throws Exception {
+        String value = json.writeValueAsString(event);
+        kafka.send(TOPIC, event.orderId(), value).get(10, TimeUnit.SECONDS);
+        return value;
+    }
+
+    // The listener must keep going after a failed record, so a following good
+    // record reaches OrderService.
+    private void assertNextRecordIsProcessed(String orderId) throws Exception {
+        PaymentSettled next = new PaymentSettled(orderId, "pay-" + orderId, 500);
+        doNothing().when(orders).markPaid(next);
+        String value = send(next);
+        await().atMost(WAIT).untilAsserted(() -> verify(orders).markPaid(next));
+        assertNoDeadLetter(value);
+    }
+
+    private ConsumerRecord<String, String> awaitDeadLetter(String value) {
+        long deadline = System.nanoTime() + WAIT.toNanos();
+        while (System.nanoTime() < deadline) {
+            Optional<ConsumerRecord<String, String>> match = pollDeadLetters(Duration.ofMillis(500))
+                    .stream().filter(record -> value.equals(record.value())).findFirst();
+            if (match.isPresent()) {
+                return match.get();
+            }
+        }
+        throw new AssertionError("No record with value " + value + " on " + DLT
+                + " within " + WAIT);
+    }
+
+    private void assertNoDeadLetter(String value) {
+        long deadline = System.nanoTime() + QUIET.toNanos();
+        while (System.nanoTime() < deadline) {
+            assertThat(pollDeadLetters(Duration.ofMillis(500)))
+                    .extracting(ConsumerRecord::value)
+                    .doesNotContain(value);
+        }
+    }
+
+    private List<ConsumerRecord<String, String>> pollDeadLetters(Duration timeout) {
+        List<ConsumerRecord<String, String>> records = new ArrayList<>();
+        deadLetters.poll(timeout).forEach(records::add);
+        return records;
+    }
+}
