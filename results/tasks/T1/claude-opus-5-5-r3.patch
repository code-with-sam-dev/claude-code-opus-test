+// list returns the first charges by id, optionally filtered by currency. The
+// filter is validated before anything is queried.
+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	var currency string
+	if values, ok := r.URL.Query()["currency"]; ok {
+		if len(values) != 1 || !isCurrencyCode(values[0]) {
+			http.Error(w, "currency must be three letters A to Z",
+				http.StatusBadRequest)
+			return
+		}
+		currency = strings.ToUpper(values[0])
+	}
+	charges, err := h.charges.List(r.Context(), currency)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if charges == nil {
+		charges = []Charge{} // encode as [], never null
+	}
+	writeJSON(w, http.StatusOK, charges)
+}
+
+// isCurrencyCode reports whether s is exactly three ASCII letters, any case.
+func isCurrencyCode(s string) bool {
+	if len(s) != 3 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !('a' <= c && c <= 'z' || 'A' <= c && c <= 'Z') {
+			return false
+		}
+	}
+	return true
+}
