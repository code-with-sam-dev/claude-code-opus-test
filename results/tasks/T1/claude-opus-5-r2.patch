+// listLimit caps every page, so one client cannot ask for the whole table.
+const listLimit = 50
+
+// List returns charges oldest first. An empty currency means no filter; the
+// caller has already normalised it.
+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	query := `SELECT id, amount, currency, status FROM charges
+		ORDER BY id ASC LIMIT $1`
+	args := []any{listLimit}
+	if currency != "" {
+		query = `SELECT id, amount, currency, status FROM charges
+			WHERE currency = $2 ORDER BY id ASC LIMIT $1`
+		args = append(args, currency)
+	}
+	rows, err := s.db.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	defer rows.Close()
+
+	// Non-nil so an empty result encodes as [] rather than null.
+	charges := []Charge{}
+	for rows.Next() {
+		var p Charge
+		if err := rows.Scan(&p.ID, &p.Amount, &p.Currency, &p.Status); err != nil {
+			return nil, fmt.Errorf("list charges: %w", err)
+		}
+		charges = append(charges, p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	return charges, nil
+}
+
