+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	currency, ok := normaliseCurrency(r.URL.Query().Get("currency"))
+	if !ok {
+		http.Error(w, "currency must be three letters", http.StatusBadRequest)
+		return
+	}
+	charges, err := h.charges.List(r.Context(), currency)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if charges == nil {
+		// A nil slice encodes as null; the response is always an array.
+		charges = []Charge{}
+	}
+	writeJSON(w, http.StatusOK, charges)
+}
+
+// normaliseCurrency upper cases a three letter code. An absent parameter is
+// valid and means no filter; anything else is rejected before any query runs.
+func normaliseCurrency(currency string) (string, bool) {
+	if currency == "" {
+		return "", true
+	}
+	if len(currency) != 3 {
+		return "", false
+	}
+	for _, c := range currency {
+		if !('a' <= c && c <= 'z') && !('A' <= c && c <= 'Z') {
+			return "", false
+		}
+	}
+	return strings.ToUpper(currency), true
+}
