+// list serves GET /charges. The optional currency query parameter must be
+// three letters, in any case, and is normalised to upper case before it
+// reaches the store. Anything else is rejected without a query.
+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	currency, ok := normaliseCurrency(r.URL.Query().Get("currency"))
+	if !ok {
+		http.Error(w, "currency must be three letters", http.StatusBadRequest)
+		return
+	}
+	ps, err := h.charges.List(r.Context(), currency)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if ps == nil {
+		ps = []Charge{} // encodes as [] rather than null
+	}
+	writeJSON(w, http.StatusOK, ps)
+}
+
+// normaliseCurrency accepts the empty string (no filter) or exactly three
+// ASCII letters, and returns the code upper-cased.
+func normaliseCurrency(s string) (string, bool) {
+	if s == "" {
+		return "", true
+	}
+	if len(s) != 3 {
+		return "", false
+	}
+	b := []byte(s)
+	for i, c := range b {
+		switch {
+		case c >= 'A' && c <= 'Z':
+		case c >= 'a' && c <= 'z':
+			b[i] = c - 'a' + 'A'
+		default:
+			return "", false
+		}
+	}
+	return string(b), true
+}
