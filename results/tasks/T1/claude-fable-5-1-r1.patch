+// List returns up to 50 charges by ascending id. An empty currency means no
+// filter, which the query expresses as a parameter rather than as a second
+// statement, so there is one query and it is fully parameterised.
+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	rows, err := s.db.QueryContext(ctx,
+		`SELECT id, amount, currency, status FROM charges
+		 WHERE $1 = '' OR currency = $1
+		 ORDER BY id ASC LIMIT 50`, currency)
+	if err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	defer rows.Close()
+
+	ps := []Charge{}
+	for rows.Next() {
+		var p Charge
+		if err := rows.Scan(&p.ID, &p.Amount, &p.Currency, &p.Status); err != nil {
+			return nil, fmt.Errorf("scan charge: %w", err)
+		}
+		ps = append(ps, p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	return ps, nil
+}
+
