+// list returns charges in id order, optionally filtered by ?currency=.
+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	var currency string
+	if values, ok := r.URL.Query()["currency"]; ok {
+		c, valid := normaliseCurrency(values)
+		if !valid {
+			http.Error(w, "currency must be three letters A to Z",
+				http.StatusBadRequest)
+			return
+		}
+		currency = c
+	}
+	charges, err := h.charges.List(r.Context(), currency)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if charges == nil {
+		charges = []Charge{} // encode as [], never null
+	}
+	writeJSON(w, http.StatusOK, charges)
+}
+
+// normaliseCurrency accepts exactly one value of three ASCII letters and
+// returns it in upper case.
+func normaliseCurrency(values []string) (string, bool) {
+	if len(values) != 1 || len(values[0]) != 3 {
+		return "", false
+	}
+	b := []byte(values[0])
+	for i, c := range b {
+		switch {
+		case 'A' <= c && c <= 'Z':
+		case 'a' <= c && c <= 'z':
+			b[i] = c - 'a' + 'A'
+		default:
+			return "", false
+		}
+	}
+	return string(b), true
+}
