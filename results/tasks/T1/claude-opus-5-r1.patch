+// listLimit caps a list page, so one request cannot ask for the whole table.
+const listLimit = 50
+
+// List returns charges by id ascending, at most listLimit of them. An empty
+// currency means every currency. The slice is never nil, so an empty page
+// encodes as [] rather than null.
+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	const columns = `SELECT id, amount, currency, status FROM charges`
+	var (
+		rows *sql.Rows
+		err  error
+	)
+	if currency == "" {
+		rows, err = s.db.QueryContext(ctx,
+			columns+` ORDER BY id LIMIT $1`, listLimit)
+	} else {
+		rows, err = s.db.QueryContext(ctx,
+			columns+` WHERE currency = $1 ORDER BY id LIMIT $2`,
+			currency, listLimit)
+	}
+	if err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	defer rows.Close()
+
+	charges := []Charge{}
+	for rows.Next() {
+		var p Charge
+		if err := rows.Scan(&p.ID, &p.Amount, &p.Currency, &p.Status); err != nil {
+			return nil, fmt.Errorf("list charges: %w", err)
+		}
+		charges = append(charges, p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	return charges, nil
+}
+
 func (s *Store) one(ctx context.Context, query string, args ...any) (Charge, error) {
 	var p Charge
 	err := s.db.QueryRowContext(ctx, query, args...).
