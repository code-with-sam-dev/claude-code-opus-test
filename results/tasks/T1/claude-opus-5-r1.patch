+// currencyCode is the only shape the currency filter may take: three letters,
+// in either case.
+var currencyCode = regexp.MustCompile(`^[A-Za-z]{3}$`)
+
+// list answers with a JSON array, so the currency is checked before anything
+// is queried and an empty page is written as [] rather than null.
+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	currency := r.URL.Query().Get("currency")
+	if currency != "" && !currencyCode.MatchString(currency) {
+		http.Error(w, "currency must be three letters", http.StatusBadRequest)
+		return
+	}
+	charges, err := h.charges.List(r.Context(), strings.ToUpper(currency))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if charges == nil {
+		charges = []Charge{}
+	}
+	writeJSON(w, http.StatusOK, charges)
+}
+
 func (h *Handlers) latest(w http.ResponseWriter, r *http.Request) {
 	h.respond(w, r, h.charges.Latest)
 }
