+// List returns up to listLimit charges ordered by id ascending. A non-empty
+// currency restricts the result to that currency; it is compared as given,
+// so callers normalise it first.
+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	query := `SELECT id, amount, currency, status FROM charges`
+	var args []any
+	if currency != "" {
+		query += ` WHERE currency = $1`
+		args = append(args, currency)
+	}
+	query += ` ORDER BY id ASC LIMIT ` + strconv.Itoa(listLimit)
+
+	rows, err := s.db.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	defer rows.Close()
+
+	charges := make([]Charge, 0) // never nil, so it encodes as [] not null
+	for rows.Next() {
+		var p Charge
+		if err := rows.Scan(&p.ID, &p.Amount, &p.Currency, &p.Status); err != nil {
+			return nil, fmt.Errorf("list charges: %w", err)
+		}
+		charges = append(charges, p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	return charges, nil
+}
