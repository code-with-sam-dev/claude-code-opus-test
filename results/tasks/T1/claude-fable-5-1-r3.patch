+// list serves GET /charges. The optional currency query parameter must be
+// three ASCII letters and is normalised to upper case before it reaches the
+// service; anything else is rejected here without touching the database.
+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	currency := r.URL.Query().Get("currency")
+	if currency != "" {
+		if !validCurrency(currency) {
+			http.Error(w, "currency must be three letters", http.StatusBadRequest)
+			return
+		}
+		currency = strings.ToUpper(currency)
+	}
+	charges, err := h.charges.List(r.Context(), currency)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if charges == nil {
+		charges = []Charge{} // encode as [] rather than null
+	}
+	writeJSON(w, http.StatusOK, charges)
+}
+
+// validCurrency reports whether s is exactly three letters A to Z in either
+// case. It checks bytes, so multi-byte characters fail as they should.
+func validCurrency(s string) bool {
+	if len(s) != 3 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c < 'A' || c > 'Z') && (c < 'a' || c > 'z') {
+			return false
+		}
+	}
+	return true
+}
