+// listLimit caps how many charges one page returns.
+const listLimit = 50
+
+// List returns charges by id ascending. An empty currency means no filter.
+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	query := `SELECT id, amount, currency, status FROM charges
+		ORDER BY id ASC LIMIT $1`
+	args := []any{listLimit}
+	if currency != "" {
+		query = `SELECT id, amount, currency, status FROM charges
+			WHERE currency = $1 ORDER BY id ASC LIMIT $2`
+		args = []any{currency, listLimit}
+	}
+	rows, err := s.db.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	defer rows.Close()
+
+	var out []Charge
+	for rows.Next() {
+		var p Charge
+		if err := rows.Scan(&p.ID, &p.Amount, &p.Currency, &p.Status); err != nil {
+			return nil, fmt.Errorf("list charges: %w", err)
+		}
+		out = append(out, p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	return out, nil
+}
+
