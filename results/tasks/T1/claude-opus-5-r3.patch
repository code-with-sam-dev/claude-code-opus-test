+	h := NewHandlers(fake, noReceipts{})
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /charges/{id}", h.get)
+	mux.HandleFunc("GET /charges/latest", h.latest)
+	mux.HandleFunc("GET /charges", h.list)
+
+	rec := httptest.NewRecorder()
