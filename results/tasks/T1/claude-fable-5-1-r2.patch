+// List returns up to listLimit charges ordered by id ascending. An empty
+// currency means no filter; the parameter is bound, never interpolated.
+func (s *Store) List(ctx context.Context, currency string) ([]Charge, error) {
+	rows, err := s.db.QueryContext(ctx,
+		`SELECT id, amount, currency, status FROM charges
+		 WHERE $1 = '' OR currency = $1
+		 ORDER BY id ASC LIMIT $2`, currency, listLimit)
+	if err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	defer rows.Close()
+
+	charges := []Charge{}
+	for rows.Next() {
+		var p Charge
+		if err := rows.Scan(&p.ID, &p.Amount, &p.Currency, &p.Status); err != nil {
+			return nil, fmt.Errorf("scan charge: %w", err)
+		}
+		charges = append(charges, p)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list charges: %w", err)
+	}
+	return charges, nil
+}
+
+const listLimit = 50
+
