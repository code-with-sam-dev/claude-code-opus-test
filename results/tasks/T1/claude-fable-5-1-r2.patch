+// list serves GET /charges. The optional currency query parameter must be
+// three ASCII letters and is normalised to upper case before it reaches the
+// database; anything else is rejected without a query.
+func (h *Handlers) list(w http.ResponseWriter, r *http.Request) {
+	currency, ok := normaliseCurrency(r.URL.Query().Get("currency"))
+	if !ok {
+		http.Error(w, "currency must be three letters", http.StatusBadRequest)
+		return
+	}
+	charges, err := h.charges.List(r.Context(), currency)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if charges == nil {
+		charges = []Charge{} // encode as [] rather than null
+	}
+	writeJSON(w, http.StatusOK, charges)
+}
+
+// normaliseCurrency returns the upper-cased code and true for an empty string
+// or exactly three ASCII letters, and false for anything else.
+func normaliseCurrency(s string) (string, bool) {
+	if s == "" {
+		return "", true
+	}
+	if len(s) != 3 {
+		return "", false
+	}
+	for _, c := range []byte(s) {
+		if (c < 'a' || c > 'z') && (c < 'A' || c > 'Z') {
+			return "", false
+		}
+	}
+	return strings.ToUpper(s), true
+}
